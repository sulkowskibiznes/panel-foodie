# Skopiuj do .env.local i uzupełnij. Te same zmienne ustaw w Vercelu (Settings -> Environment Variables).
# Wartości sekretów nigdy nie trafiają do repo ani do rozmowy z Claude.

# Adres aplikacji (lokalnie http://localhost:3000, na produkcji https://panel.foodiemedia.pl)
NEXT_PUBLIC_APP_URL=

# Supabase: Project Settings -> API Keys (nowe klucze publishable / secret, nie anon / service_role)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... TYLKO po stronie serwera, NIGDY z przedrostkiem NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Podpis cookie sesji klienta, szyfrowanie tokenu linku, pieprz do hashy IP (HKDF): openssl rand -hex 32
SESSION_SECRET=

# Autoryzacja cronów Vercela (nagłówek Authorization: Bearer ...): openssl rand -hex 32
CRON_SECRET=

# Filtr wstępny logowania zespołu: domeny lub adresy po przecinku, np. foodiemedia.pl,ktos@gmail.com
# Prawdziwa lista dopuszczonych to tabela team_members (active = true).
TEAM_EMAIL_ALLOWLIST=

# Import z Dysku Google (faza 4): JSON klucza konta usługi (surowy albo zakodowany base64) i ID folderu
# "Materiały klientów" (z paska adresu: /drive/folders/<ID>). Folder udostępniony na adres konta usługi z prawem odczytu.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# DRIVE_ATRAPA=1 podmienia Dysk na atrapę w pamięci (testy E2E i pnpm dev:lokalny ustawiają to same). Puste na produkcji.
DRIVE_ATRAPA=

# Powiadomienia (faza 5): adres Catch Hook w Zapierze
ZAPIER_WEBHOOK_URL=

# Webhook rejestrujący raporty (faza 5), nagłówek Authorization: Bearer ...: openssl rand -hex 32
INGEST_TOKEN=

# --- Tokeny narzędziowe (tylko lokalnie, nie w aplikacji i nie w Vercelu) ---
# Supabase CLI (link, db push, gen types): https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Vercel CLI (zmienne środowiskowe, wdrożenia): https://vercel.com/account/tokens
VERCEL_TOKEN=
